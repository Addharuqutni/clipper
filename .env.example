# =============================================================================
# ClipperAI — contoh konfigurasi (.env di akar repo)
#
# TIDAK perlu menyalin file ini: start.cmd membuat .env berisi
# TOKEN_ENCRYPTION_KEY acak saat pertama kali dijalankan. Semua variabel di
# bawah bersifat opsional; tambahkan ke .env hanya yang ingin diubah.
# JANGAN pernah membagikan .env: isinya kunci enkripsi kunci API dan cookies.
# =============================================================================

# -----------------------------------------------------------------------------
# Wajib (dibuat otomatis): 32 byte base64 untuk AES-256-GCM. Mengganti kunci
# membuat kunci API tersimpan dan cookies YouTube tidak dapat dibaca lagi
# (isi ulang di halaman Setelan/YouTube).
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Lokasi berkas. Jalur relatif = relatif terhadap folder repo.
# -----------------------------------------------------------------------------
# Basis data SQLite dan semua media; tiap job dapat satu folder
# <judul>-<id> berisi video sumber dan klipnya.
# LOCAL_STORAGE_DIR=output
# Ruang kerja sementara (butuh beberapa GB untuk video panjang).
# WORKER_WORKSPACE_DIR=.work
# Cache model Whisper.
# WHISPER_MODEL_CACHE_DIR=.models
# FACE_LANDMARKER_MODEL=.models/face_landmarker.task
# FFmpeg: bawaan .libs/ffmpeg/ffmpeg.exe (diunduh start.cmd), lalu PATH.
# FFMPEG_BINARY=
# FFPROBE_BINARY=
# YTDLP_BINARY=

# -----------------------------------------------------------------------------
# Penyedia AI cadangan bila belum diisi di halaman Setelan.
# -----------------------------------------------------------------------------
# AI_PROVIDER_PRESET=gemini
# GEMINI_API_KEY=
# CUSTOM_AI_BASE_URL=
# CUSTOM_AI_MODEL=
# CUSTOM_AI_API_KEY=
# ALLOW_PRIVATE_AI_HOST=false
# Konteks model (token) bila penyedia tidak melaporkannya; kosong = 128000.
# AI_CONTEXT_TOKENS=
# Batas atas durasi video (menit); yang berlaku = min(ini, kapasitas konteks).
# MAX_VIDEO_DURATION_MIN=180

# -----------------------------------------------------------------------------
# Transkripsi (Whisper)
# -----------------------------------------------------------------------------
# local = faster-whisper di CPU; remote = API OpenAI-compatible.
# STT_BACKEND=local
# Bawaan large-v3-turbo (±1,6 GB, paling akurat untuk bahasa Indonesia; ±1x
# durasi video di CPU 4 core). "small" ±3x lebih cepat tapi lebih banyak salah kata.
# WHISPER_MODEL=large-v3-turbo
# WHISPER_COMPUTE_TYPE=int8
# Kosong = jumlah core fisik (hyperthread memperlambat Whisper).
# WHISPER_CPU_THREADS=
# Hanya untuk STT_BACKEND=remote:
# WHISPER_API_KEY=
# WHISPER_API_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Kinerja. Satu pekerjaan berat per jenis secara bawaan supaya komputer tetap
# responsif; naikkan hanya bila CPU >= 8 core.
# -----------------------------------------------------------------------------
# RENDER_SLOTS=1
# STT_SLOTS=1
# INGEST_WORKERS=2
# FFMPEG_THREADS=2
# CV_NUM_THREADS=1
# RENDER_FINAL_CRF=18
# RENDER_FINAL_PRESET=slow
# RENDER_PREVIEW_CRF=30
# RENDER_PREVIEW_PRESET=veryfast
# Render final semua klip otomatis setelah analisis (false = render manual).
# AUTO_RENDER_FINAL=true
# Agent pemilihan momen tiga pass: SCOUT menandai kandidat per jendela, JUDGE
# menilai tiap kandidat dari teks utuhnya, CRITIC membuang yang tumpang tindih.
# Kosong/false = satu panggilan seperti sebelumnya. Agent jauh lebih mahal dan
# lambat, dan belum diukur terhadap jalur satu-pass — bandingkan dulu dengan
# `scripts/eval_scoring.py` sebelum menjadikannya bawaan.
# MOMENT_AGENT=1

# -----------------------------------------------------------------------------
# Retensi: media sumber dihapus N jam setelah render terakhir job selesai.
# -----------------------------------------------------------------------------
# RAW_MEDIA_TTL_HOURS=48
